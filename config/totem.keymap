ZMK_LAYER(sys,
//              ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮  ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  ___           &bt BT_CLR       UNLOCK        ___           ___           ___           ___          
//              ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤  ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                  &out OUT_TOG  VCC_OFF       ___           ___           &bootloader      &bootloader   ___           ___           ___           ___          
//╭───────────╮ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤  ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ╭───────────╮
    ___           ___           ___           ___           ___           &sys_reset       &sys_reset    ___           ___           ___           ___             ___
